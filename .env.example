# Ermeion Website Environment Variables

# Base Production URL (χρησιμοποιείται για Canonical URLs και Open Graph links)
VITE_SITE_URL=https://ermeion.gr

# Google Analytics 4 Measurement ID
# Αντικαταστήστε με το δικό σας Google Analytics 4 Measurement ID όταν είναι έτοιμο:
VITE_GA_ID=G-XXXXXXXXXX
