  RewriteRule ^ https://ermeion.gr/arthra/vlavi-vrachioniou-plegmatos [R=301,NE,L]

  # Elbow pain
  RewriteCond %{REQUEST_URI} ^/(πονος-στον-αγκωνα|%cf%80%ce%bf%ce%bd%ce%bf%cf%82-%cf%83%cf%84%ce%bf%ce%bd-%ce%b1%ce%b3%ce%ba%cf%89%ce%bd%ce%b1|εκτασεισ-επιφορτισμενου-αγκωνα-με-υπ|%ce%b5%ce%ba%cf%84%ce%b1%cf%83%ce%b5%ce%b9%cf%83-%ce%b5%cf%80%ce%b9%cf%86%ce%bf%cf%81%cf%84%ce%b9%cf%83%ce%bc%ce%b5%ce%bd%ce%bf%cf%85-%ce%b1%ce%b3%ce%ba%cf%89%ce%bd%ce%b1-%ce%bc%ce%b5-%cf%85%cf%80)/?$ [NC]
  RewriteRule ^ https://ermeion.gr/arthra/ponos-ston-agkona [R=301,NE,L]

  # Rotator cuff tendinopathy
  RewriteCond %{REQUEST_URI} ^/(πεταλο-στροφεων-του-ωμου-τεντοπαθεια|%cf%80%ce%b5%cf%84%ce%b1%ce%bb%ce%bf-%cf%83%cf%84%cf%81%ce%bf%cf%86%ce%b5%cf%89%ce%bd-%cf%84%ce%bf%cf%85-%cf%89%ce%bc%ce%bf%cf%85-%cf%84%ce%b5%ce%bd%cf%84%ce%bf%cf%80%ce%b1%ce%b8%ce%b5%ce%b9%ce%b1)/?$ [NC]
