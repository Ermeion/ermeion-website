  RewriteRule ^ https://ermeion.gr/arthra/pathologia-tis-pelmatias-aponevrosis [R=301,NE,L]

  # Achilles tendinopathy
  RewriteCond %{REQUEST_URI} ^/(τενοντοπαθεια-αχιλλειου-τενοντα|%cf%84%ce%b5%ce%bd%ce%bf%ce%bd%cf%84%ce%bf%cf%80%ce%b1%ce%b8%ce%b5%ce%b9%ce%b1-%ce%b1%cf%87%ce%b9%ce%bb%ce%bb%ce%b5%ce%b9%ce%bf%cf%85-%cf%84%ce%b5%ce%bd%ce%bf%ce%bd%cf%84%ce%b1)/?$ [NC]
  RewriteRule ^ https://ermeion.gr/arthra/tenontopatheia-achilleiou-tenonta [R=301,NE,L]

  # Achilles tendon rupture
