  RewriteRule ^ https://ermeion.gr/arthra/ponos-sto-ischio [R=301,NE,L]

  # Knee osteoarthritis
  RewriteCond %{REQUEST_URI} ^/(οστεοαρθριτιδα-γονατος|%ce%bf%cf%83%cf%84%ce%b5%ce%bf%ce%b1%cf%81%ce%b8%cf%81%ce%b9%cf%84%ce%b9%ce%b4%ce%b1-%ce%b3%ce%bf%ce%bd%ce%b1%cf%84%ce%bf%cf%82)/?$ [NC]
  RewriteRule ^ https://ermeion.gr/arthra/osteoarthritida-gonatos [R=301,NE,L]

  # Brachial plexus injury
