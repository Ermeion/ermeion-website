  RewriteRule ^ https://ermeion.gr/arthra/syndromo-epigonatidomiriaiou-ponou [R=301,NE,L]

  # Bursitis
  RewriteCond %{REQUEST_URI} ^/(ορογονοθυλακιτιδα-bursitis|%ce%bf%cf%81%ce%bf%ce%b3%ce%bf%ce%bd%ce%bf%ce%b8%cf%85%ce%bb%ce%b1%ce%ba%ce%b9%cf%84%ce%b9%ce%b4%ce%b1-bursitis)/?$ [NC]
  RewriteRule ^ https://ermeion.gr/arthra/orogonothylakitida-bursitis [R=301,NE,L]

  # Plantar fasciitis
